{
  "apiBaseUrlPopularMovies": "$[env:API_BASE_URL_POPULAR_MOVIES;default=https://api.themoviedb.org/3/movie/popular]",
  "apiKeyPopularMovies": "$[secret:API_KEY_POPULAR_MOVIES;default=your_api_key]",
  "connectionTimeoutMs": "$[env:CONNECTION_TIMEOUT_MS;default=5000]",
